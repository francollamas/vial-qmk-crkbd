    "rgb_matrix": {
        "animations": {
            // === STATIC EFFECTS ===
            "solid_color": true, // Solid uniform color across entire keyboard

            // === BREATHING EFFECTS ===
            "breathing": true, // Smooth breathing (brightness fades in/out)
            "hue_breathing": true, // Breathing with hue/color change

            // === RAINBOW/CYCLE EFFECTS ===
            "cycle_all": true, // Rainbow cycling through all colors uniformly
            "cycle_left_right": false, // Rainbow scrolling from left to right
            "cycle_up_down": false, // Rainbow scrolling from top to bottom
            "cycle_out_in": false, // Rainbow radiating from center outward
            "cycle_out_in_dual": false, // Dual rainbow radiating from center outward
            "cycle_pinwheel": false, // Rainbow in pinwheel/spinner pattern
            "cycle_spiral": true, // Rainbow in spiral pattern from center

            // === STATIC GRADIENTS ===
            "gradient_up_down": true, // Vertical color gradient (top-bottom)
            "gradient_left_right": true, // Horizontal color gradient (left-right)

            // === BAND EFFECTS ===
            "band_sat": true, // Horizontal bands with saturation variation
            "band_val": true, // Horizontal bands with brightness variation
            "band_pinwheel_sat": false, // Pinwheel bands with saturation variation
            "band_pinwheel_val": false, // Pinwheel bands with brightness variation
            "band_spiral_sat": true, // Spiral bands with saturation variation
            "band_spiral_val": true, // Spiral bands with brightness variation

            // === FUNCTIONAL/UTILITY EFFECTS ===
            "alphas_mods": true, // Different colors for alphanumeric vs modifier keys

            // === SPECIAL/VISUAL EFFECTS ===
            "rainbow_moving_chevron": false, // Moving rainbow chevron (V) pattern
            "raindrops": false, // Random raindrops falling
            "pixel_fractal": false, // Mathematical pixelated fractal pattern
            "pixel_flow": false, // Flowing pixel movement
            "pixel_rain": false, // Falling pixel rain
            "jellybean_raindrops": false, // Random multicolor "jelly bean" drops
            "digital_rain": true, // Matrix effect - digital rain

            // === TYPING REACTIVE EFFECTS ===
            "typing_heatmap": true, // Heat map showing most-used keys

            // === SOLID REACTIVE (single color reaction) ===
            "solid_reactive_simple": true, // Simple brightness on key press
            "solid_reactive": true, // Key lights up and fades on press
            "solid_reactive_wide": false, // Lights key + neighbors widely
            "solid_reactive_multiwide": true, // Wide effect for multiple simultaneous keys
            "solid_reactive_cross": false, // Cross (+) shape lights on press
            "solid_reactive_multicross": true, // Cross for multiple simultaneous keys
            "solid_reactive_nexus": false, // Circular wave expanding from pressed key
            "solid_reactive_multinexus": true, // Nexus for multiple simultaneous keys
            "solid_splash": false, // Splash expanding from key press
            "solid_multisplash": true, // Splash for multiple simultaneous keys

            // === RAINBOW REACTIVE (reaction with rainbow colors) ===
            "reactive_simple": false, // Simple rainbow brightness on press
            "reactive": false, // Key lights up rainbow and fades
            "reactive_wide": false, // Wide rainbow affecting neighbor keys
            "reactive_multinexus": false, // Multiple simultaneous rainbow waves
            "reactive_multicross": false, // Multiple simultaneous rainbow crosses
            "reactive_splash": false, // Rainbow splash expanding outward
            "reactive_multisplash": false // Multiple simultaneous rainbow splashes
